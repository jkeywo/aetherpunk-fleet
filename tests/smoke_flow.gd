extends "res://tests/support/v3_test.gd"
func _run() -> void:
	root.size = Vector2i(1280, 800)
	root.get_node("ContentStore").saved = fixture.duplicate(true)
	change_scene_to_file("res://scenes/main_menu.tscn")
	await scene_changed
	current_scene.get_node("%PrimaryButton").pressed.emit()
	await scene_changed
	expect(current_scene.name == "FleetPreparation", "Main menu bypassed fleet preparation.")
	current_scene.launch_button.pressed.emit()
	await scene_changed
	current_scene.start_button.pressed.emit()
	await scene_changed
	var b = current_scene
	b.feedback.duration_scale = 0.01
	await flush()
	expect(b.hand_view.get_child_count() == 7 and b.state.enemies.size() == 3, "Saved fleet/enemies not loaded.")
	expect(b.stance_panel.get_child_count() > 0 and b.state.enemy_row.size() == 3, "Shared row missing.")
	expect(b.allies.widgets.size() == 4 and b.enemies.widgets.size() == 4, "Diamond slots missing.")
	expect(b.circle_view.buttons[4].disabled, "Circle expanded too early.")
	var split: float = b.canvas.size.x / 2
	expect(b.actions.position.x + b.actions.size.x <= split and b.inspection_scroll.position.x + b.inspection_scroll.size.x <= split, "Combat controls and help overlap the enemy card area.")
	expect(b.stance_panel.position.x > split and b.stance_panel.position.y + b.stance_panel.size.y <= b.hand_view.position.y, "Enemy row does not fit in the right half above the hand.")
	expect(b.inspection_scroll.position.y + b.inspection_scroll.size.y <= b.hand_view.position.y and b.hand_view.position.y + b.hand_view.size.y <= b.canvas.size.y, "Hand overlaps help or extends past the battle canvas.")
	expect(b.get_node_or_null("%Title") == null and b.circle_view.position.y < b.allies.position.y, "Combat title or top spacing still takes up board space.")
	var mana: Button = b.get_node("%ManaButton")
	var boosts: Button = b.get_node("%BoostButton")
	var cancel: Button = b.get_node("%CancelButton")
	expect(mana.position.x == boosts.position.x and boosts.position.x == cancel.position.x and mana.position.y < boosts.position.y and boosts.position.y < cancel.position.y, "Action buttons are not stacked.")
	var history: Button = b.get_node("%HistoryButton")
	var end_phase: Button = b.get_node("%EndPhaseButton")
	expect(end_phase.text == "End Turn", "End Turn has the wrong label.")
	var deck: Control = b.get_node("%DeckPile")
	var discard: Control = b.get_node("%DiscardPile")
	expect(is_equal_approx(history.get_rect().get_center().x, deck.get_rect().get_center().x) and history.get_rect().end.y <= deck.position.y, "History is not centered above the deck.")
	expect(is_equal_approx(end_phase.get_rect().get_center().x, discard.get_rect().get_center().x) and end_phase.get_rect().end.y <= discard.position.y, "End Turn is not centered above discard.")
	expect(b.allies.widgets[0].size.x > 140 and b.enemies.widgets[0].size.y > 128 and b.allies.size.y > 308, "Battle formations or sprites retained the old size.")
	var hand: Array = b.state.hand.duplicate()
	b.state.hand.clear()
	b._update_controls()
	expect(b.end_phase_highlight.visible and not end_phase.disabled, "End Turn does not highlight when the hand is empty.")
	b.state.hand.assign(hand)
	b._update_controls()
	expect(not b.end_phase_highlight.visible, "End Turn stayed highlighted after restoring the hand.")
	stage_card(b, "broadside", 1)
	choose_first_targets(b)
	await pay_with(b, "brace")
	expect(b.pending_play, "Payment did not remain staged until the automatic resolve frame.")
	var before: int = b.state.monster_hull
	await settle(b)
	expect(b.state.circle[1] >= 0 and b.state.monster_hull < before, "Card did not resolve.")
	expect(b.hand_view.get_child_count() == 5 and conserved(b.state), "Hand not updated.")
	b.get_node("%EndPhaseButton").pressed.emit()
	await b.resolution_finished
	expect(b.state.round_number == 2 and b.state.phase == "fleet", "Enemy phase/automatic refresh failed.")
	await settle(b)
	expect(b.state.hand.size() == 7 and b.state.mana == 1, "Retained-hand refresh/mana failed.")
	b.get_node("%GearButton").pressed.emit()
	expect(paused, "Menu did not pause.")
	b.menu.id_pressed.emit(0)
	b.menu.hide()
	expect(not paused, "Resume failed.")
	b.get_node("%GearButton").pressed.emit()
	b.menu.id_pressed.emit(2)
	await scene_changed
	expect(current_scene.name == "MainMenu" and not paused, "Menu route failed.")
	done("Battle UI navigation")
